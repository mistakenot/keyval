{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/dev/schedule.v1.schema.json",
  "title": "keyval.dev.schedule/v1",
  "description": "The `./dev schedule install|status|run --json` report (xtask/src/schedule.rs `ScheduleReport`): the local hourly T1 and nightly T2 jobs, what each owes, what it ran, queued, left incomplete or missed (PLAN.md §10.10, §10.11, §11.12). A missed slot is never a pass; an interrupted run is `incomplete` with its seeds explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "action", "now", "at", "jobs", "install", "run", "error"],
  "properties": {
    "schema": { "const": "keyval.dev.schedule/v1" },
    "ok": { "type": "boolean" },
    "action": { "enum": ["install", "status", "run"] },
    "now": { "type": "integer", "minimum": 0, "description": "Seconds since the epoch." },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "jobs": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/job_status" } },
    "install": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/install" }] },
    "run": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ran" }] },
    "error": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "description": "An ok report has no error.",
      "if": { "required": ["ok"], "properties": { "ok": { "const": true } } },
      "then": { "properties": { "error": { "type": "null" } } }
    },
    {
      "description": "Only `install` reports units.",
      "if": { "required": ["action"], "properties": { "action": { "not": { "const": "install" } } } },
      "then": { "properties": { "install": { "type": "null" } } }
    }
  ],
  "$defs": {
    "job": { "enum": ["t1", "t2"] },
    "state": { "enum": ["queued", "running", "passed", "failed", "incomplete"] },
    "blocker": { "enum": ["t0_commit", "campaign_running", "t1_due"] },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "completed", "remaining"],
      "properties": {
        "target": { "type": "integer", "minimum": 1 },
        "completed": { "type": ["integer", "null"], "minimum": 0 },
        "remaining": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "job", "slot", "attempt", "state", "queued_at", "started_at", "finished_at",
        "resumes", "blocked_by", "tree", "receipt", "seeds", "detail"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^t[12]-[0-9]+-a[0-9]+$" },
        "job": { "$ref": "#/$defs/job" },
        "slot": { "type": "integer", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/state" },
        "queued_at": { "type": "integer", "minimum": 0 },
        "started_at": { "type": ["integer", "null"], "minimum": 0 },
        "finished_at": { "type": ["integer", "null"], "minimum": 0 },
        "resumes": { "type": ["string", "null"] },
        "blocked_by": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/blocker" }] },
        "tree": { "type": ["string", "null"] },
        "receipt": { "type": ["string", "null"] },
        "seeds": { "$ref": "#/$defs/seeds" },
        "detail": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "description": "A run that ended in a pass or a failure says when it ended.",
          "if": { "required": ["state"], "properties": { "state": { "enum": ["passed", "failed"] } } },
          "then": { "properties": { "finished_at": { "type": "integer" } } }
        },
        {
          "description": "An interrupted run states how many seeds are still owed.",
          "if": { "required": ["state"], "properties": { "state": { "const": "incomplete" } } },
          "then": { "properties": { "seeds": { "properties": { "remaining": { "type": "integer" } } } } }
        }
      ]
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["due"],
          "properties": { "due": { "const": "not_yet" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["due", "slot", "record"],
          "properties": {
            "due": { "enum": ["done", "in_progress"] },
            "slot": { "type": "integer", "minimum": 0 },
            "record": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["due", "slot", "attempt", "resumes", "queued"],
          "properties": {
            "due": { "const": "owed" },
            "slot": { "type": "integer", "minimum": 0 },
            "attempt": { "type": "integer", "minimum": 1 },
            "resumes": { "type": ["string", "null"] },
            "queued": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "job_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job", "latest_slot", "due", "missed", "recent"],
      "properties": {
        "job": { "$ref": "#/$defs/job" },
        "latest_slot": { "type": ["integer", "null"], "minimum": 0 },
        "due": { "$ref": "#/$defs/due" },
        "missed": { "type": "array", "maxItems": 168, "items": { "type": "integer", "minimum": 0 } },
        "recent": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/record" } }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir", "units", "applied", "commands"],
      "properties": {
        "dir": { "type": "string" },
        "units": { "type": "array", "items": { "type": "string" } },
        "applied": { "type": "boolean" },
        "commands": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "ran": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "record"],
      "properties": {
        "outcome": { "enum": ["ran", "queued", "nothing"] },
        "record": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/record" }] }
      }
    }
  }
}
