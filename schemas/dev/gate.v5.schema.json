{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/dev/gate.v5.schema.json",
  "title": "keyval.dev.gate/v5",
  "description": "The `./dev gate <tier> --json` report (xtask/src/gate.rs `GateReport`): where the receipt went, and the keyval.dev.receipt/v4 receipt itself. `ok` is true exactly when the receipt's result is `passed`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "receipt_path",
    "receipt"
  ],
  "properties": {
    "schema": {
      "const": "keyval.dev.gate/v5"
    },
    "ok": {
      "type": "boolean"
    },
    "receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "receipt": {
      "$ref": "receipt.v5.schema.json"
    }
  },
  "if": {
    "required": [
      "ok"
    ],
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "receipt": {
        "properties": {
          "result": {
            "const": "passed"
          }
        }
      }
    }
  },
  "else": {
    "properties": {
      "receipt": {
        "properties": {
          "result": {
            "const": "failed"
          }
        }
      }
    }
  }
}
