{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/dev/traceability.v1.schema.json",
  "title": "keyval.dev.traceability/v1",
  "description": "The `./dev report traceability --json` report (xtask/src/traceability.rs `TraceabilityReport`). For each §6 requirement it gives the declared and derived status, the listing work items, the covering checks with their latest receipts, and whether the requirement is passed on the judged tree (PLAN.md §10.13). Without a tree, nothing is judged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ok", "path", "tree", "summary", "registry", "requirements"],
  "if": { "required": ["tree"], "properties": { "tree": { "type": "null" } } },
  "then": {
    "properties": {
      "requirements": { "items": { "properties": { "passed": { "type": "null" } } } },
      "summary": { "properties": { "passed": { "const": 0 } } }
    }
  },
  "properties": {
    "schema": { "const": "keyval.dev.traceability/v1" },
    "ok": { "type": "boolean" },
    "path": { "type": "string", "minLength": 1 },
    "tree": { "type": ["string", "null"], "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "active", "passed", "uncovered", "mismatched"],
      "properties": {
        "requirements": { "$ref": "#/$defs/count" },
        "active": { "$ref": "#/$defs/count" },
        "passed": { "$ref": "#/$defs/count" },
        "uncovered": {
          "description": "Active MUST requirements without an implemented covering check (§10.13 condition 2).",
          "$ref": "#/$defs/ids"
        },
        "mismatched": {
          "description": "Requirements whose declared status differs from the derived one.",
          "$ref": "#/$defs/ids"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["violations", "reported", "error"],
      "properties": {
        "violations": { "$ref": "#/$defs/lines" },
        "reported": {
          "description": "Conditions reported but not failed (5 and 6 until W32).",
          "$ref": "#/$defs/lines"
        },
        "error": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "lines": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["planned", "active"] },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "title",
        "notes",
        "status",
        "derived",
        "listed_by",
        "checks",
        "passed"
      ],
      "if": { "required": ["status"], "properties": { "status": { "const": "planned" } } },
      "then": {
        "description": "A planned requirement is never passed (§10.13).",
        "properties": { "passed": { "not": { "const": true } } }
      },
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "level": { "enum": ["MUST", "SHOULD", "MAY"] },
        "title": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"], "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "derived": { "$ref": "#/$defs/status" },
        "listed_by": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "closed"],
            "properties": {
              "item": { "type": "string", "minLength": 1 },
              "closed": { "type": "boolean" }
            }
          }
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/covering" } },
        "passed": { "type": ["boolean", "null"] }
      }
    },
    "covering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "class", "tier", "status", "latest", "on_tree"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "latest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/evidence" }] },
        "on_tree": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/evidence" }] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "outcome", "cases", "tree", "at", "receipt", "source"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "cases": { "type": ["integer", "null"], "minimum": 0 },
        "tree": { "type": "string" },
        "at": { "type": "string" },
        "receipt": { "type": "string", "minLength": 1 },
        "source": { "enum": ["accept", "gate"] }
      }
    }
  }
}
