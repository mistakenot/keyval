{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/dev/smoke.v1.schema.json",
  "title": "keyval.dev.smoke/v1",
  "description": "The report of `./dev smoke lifecycle` (xtask/src/lifecycle.rs `SmokeReport`; PLAN.md §10.17, T-14, §12.2 W24.3): the five-node lifecycle smoke, step by step, with the index of the last acknowledged write and the nodes killed with SIGKILL. A passing smoke has no failed step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "label",
    "run_dir",
    "keys",
    "last_index",
    "killed",
    "steps",
    "limitations",
    "step_log"
  ],
  "properties": {
    "schema": {
      "const": "keyval.dev.smoke/v1"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether every step passed."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "What the smoke is and is not (P6)."
    },
    "run_dir": {
      "type": "string",
      "minLength": 1,
      "description": "The run directory, relative to the workspace root; kept afterwards."
    },
    "keys": {
      "type": "integer",
      "minimum": 1,
      "description": "How many keys were written and verified."
    },
    "last_index": {
      "description": "The log index of the last acknowledged write; null if no write was acknowledged.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "killed": {
      "type": "array",
      "description": "The nodes killed with SIGKILL, in order.",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "step.v1.schema.json"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "step_log": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "required": [
      "ok"
    ],
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "steps": {
        "minItems": 1,
        "not": {
          "contains": {
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "const": "failed"
              }
            }
          }
        }
      }
    }
  }
}
