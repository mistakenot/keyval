{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/dev/sim-campaign.v1.schema.json",
  "title": "keyval.dev.sim-campaign/v1",
  "description": "The `./dev sim campaign --seeds A..B --json` report (PLAN.md \u00a710.9, \u00a712.2 W42.1): a seed range of the swarm profile run in parallel `keyval-sim` processes, one line per seed in seed order (xtask/src/sim_campaign.rs). `ok` is true exactly when every seed passed; a seed whose process produced no report is an `error` line, never skipped (P10). The counts add up to the number of seeds, which is `to - from + 1`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "label",
    "profile",
    "from",
    "to",
    "jobs",
    "counts",
    "seeds"
  ],
  "properties": {
    "schema": {
      "const": "keyval.dev.sim-campaign/v1"
    },
    "ok": {
      "type": "boolean"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "swarm"
    },
    "from": {
      "type": "integer",
      "minimum": 0
    },
    "to": {
      "type": "integer",
      "minimum": 0
    },
    "jobs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "incomplete",
        "error"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seed",
          "verdict",
          "trace_hash",
          "trace_path",
          "reason"
        ],
        "properties": {
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "incomplete",
              "error"
            ]
          },
          "trace_hash": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "trace_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "verdict"
              ],
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "null"
                },
                "trace_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "verdict"
              ],
              "properties": {
                "verdict": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "trace_hash": {
                  "type": "null"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "description": "ok exactly when nothing but passes was counted.",
      "if": {
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "fail": {
                "const": 0
              },
              "incomplete": {
                "const": 0
              },
              "error": {
                "const": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "counts": {
            "anyOf": [
              {
                "properties": {
                  "fail": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "incomplete": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "error": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "pass": {
                    "const": 0
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
