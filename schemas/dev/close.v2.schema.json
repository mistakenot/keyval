{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/dev/close.v2.schema.json",
  "title": "keyval.dev.close/v2",
  "description": "The `./dev commit --close <bead> [--failed --evidence <path>] --json` report (xtask/src/closure.rs `CloseReport`). `commit` is the wrapped keyval.dev.commit/v1 report, once the closure reached the commit wrapper. v2 adds `demoted`: every closure recomputes requirement statuses both ways (br-item-closure-identity-unverified-xp14).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "mode",
    "bead",
    "accept_receipt",
    "work_commit",
    "work_tree",
    "activated",
    "demoted",
    "commit",
    "detail"
  ],
  "properties": {
    "schema": {
      "const": "keyval.dev.close/v2"
    },
    "ok": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "close",
        "failed"
      ]
    },
    "bead": {
      "type": "string"
    },
    "accept_receipt": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "work_commit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "work_tree": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "activated": {
      "description": "Requirement IDs this closure activated.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "demoted": {
      "description": "Requirement IDs this closure demoted to planned: a listing item's bead is open again.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "commit.v1.schema.json"
        }
      ]
    },
    "detail": {
      "description": "Why it stopped; also set on success when HEAD already records the closure.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
