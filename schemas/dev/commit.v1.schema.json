{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/dev/commit.v1.schema.json",
  "title": "keyval.dev.commit/v1",
  "description": "The `./dev commit --json` report, also written as the commit receipt (xtask/src/commit.rs `CommitReport`). `ok` is true exactly when the gated tree was committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "outcome",
    "bead",
    "agent",
    "paths",
    "changed",
    "parent",
    "tree",
    "commit",
    "attempts",
    "gate_receipt",
    "push",
    "receipt_path",
    "detail",
    "at"
  ],
  "if": { "required": ["ok"], "properties": { "ok": { "const": true } } },
  "then": {
    "properties": {
      "outcome": { "const": "committed" },
      "parent": { "type": "string" },
      "tree": { "type": "string" },
      "commit": { "type": "string" },
      "attempts": { "minimum": 1 }
    }
  },
  "else": {
    "properties": {
      "outcome": { "enum": ["refused", "gate_failed"] },
      "commit": { "type": "null" }
    }
  },
  "properties": {
    "schema": { "const": "keyval.dev.commit/v1" },
    "ok": { "type": "boolean" },
    "outcome": { "enum": ["committed", "refused", "gate_failed"] },
    "bead": { "type": "string" },
    "agent": { "type": "string" },
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "changed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "parent": { "type": ["string", "null"], "minLength": 1 },
    "tree": { "type": ["string", "null"], "minLength": 1 },
    "commit": { "type": ["string", "null"], "minLength": 1 },
    "attempts": { "type": "integer", "minimum": 0 },
    "gate_receipt": { "type": ["string", "null"], "minLength": 1 },
    "push": {
      "description": "One line per push refspec.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt_path": { "type": ["string", "null"], "minLength": 1 },
    "detail": { "type": ["string", "null"], "minLength": 1 },
    "at": {
      "description": "Time of the decision: UTC, RFC 3339, whole seconds (xtask/src/clock.rs).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
