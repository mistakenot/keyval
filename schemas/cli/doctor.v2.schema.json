{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/cli/doctor.v2.schema.json",
  "title": "keyval.cli.doctor/v2",
  "description": "The report of `keyval doctor <data-dir> --json` (PLAN.md O-6, O-7): what startup recovery would do with a node's data directory, examined offline without modifying it. v2 (br-riea): `refusal.init_allowed` may be null (unknown without --config/--node), and the verdict may be `changed` (no LOCK file, and the journal or the lock moved while it was read).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "data_dir",
    "lock",
    "verdict",
    "would_do",
    "binding",
    "journal_len",
    "durable_len",
    "frames",
    "last_index",
    "last_term",
    "hard_state",
    "genesis",
    "tail",
    "refusal"
  ],
  "properties": {
    "schema": {
      "const": "keyval.cli.doctor/v2"
    },
    "data_dir": {
      "type": "string"
    },
    "lock": {
      "description": "The lock probe's result; null if the directory could not be opened.",
      "enum": [
        "acquired",
        "no_lock_file",
        "live",
        null
      ]
    },
    "verdict": {
      "description": "clean and discard_tail start (exit 0); the rest do not (exit 1).",
      "enum": [
        "clean",
        "discard_tail",
        "refuse",
        "live",
        "no_journal",
        "unreadable",
        "changed"
      ]
    },
    "would_do": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "description": "verified: the genesis record matches --config/--node; mismatch: it does not (refusal genesis_mismatch); unchecked: no --config, or no genesis record was read.",
      "enum": [
        "verified",
        "mismatch",
        "unchecked"
      ]
    },
    "journal_len": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "durable_len": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "frames": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "last_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "last_term": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "hard_state": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "term",
            "vote",
            "commit"
          ],
          "properties": {
            "term": {
              "type": "integer",
              "minimum": 0
            },
            "vote": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "commit": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "genesis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instance_id",
            "cluster_id",
            "node_id",
            "voters",
            "fingerprint"
          ],
          "properties": {
            "instance_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "cluster_id": {
              "type": "string",
              "minLength": 1
            },
            "node_id": {
              "type": "integer",
              "minimum": 1
            },
            "voters": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "tail": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "len",
            "shape",
            "frame_len",
            "sequence"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "len": {
              "type": "integer",
              "minimum": 1
            },
            "shape": {
              "enum": [
                "incomplete",
                "checksum_failed",
                "unreadable",
                "stale"
              ]
            },
            "frame_len": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "sequence": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    },
    "refusal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "init_allowed"
          ],
          "properties": {
            "code": {
              "enum": [
                "empty",
                "incomplete_genesis",
                "not_an_interrupted_init",
                "impossible_header",
                "not_genesis",
                "genesis_record",
                "genesis_mismatch",
                "record",
                "apply",
                "corruption",
                "tail_too_long",
                "storage"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "init_allowed": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether init may (re-)run (§7.7 step 0); null when that depends on the genesis frame's length and no --config/--node was given."
            }
          }
        }
      ]
    }
  }
}
