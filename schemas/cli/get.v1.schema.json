{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyval.invalid/schemas/cli/get.v1.schema.json",
  "title": "keyval.cli.get/v1",
  "description": "The report of keyval get. Exit 0: found. Exit 1: not_found or rejected. Exit 3: unresolved (a read changes nothing; run it again).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "key",
    "result",
    "value",
    "version",
    "node",
    "server",
    "rejection",
    "unresolved",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "keyval.cli.get/v1"
    },
    "key": {
      "type": "string"
    },
    "result": {
      "enum": [
        "found",
        "not_found",
        "rejected",
        "unresolved",
        "unexpected"
      ]
    },
    "value": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "node": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "server": {
      "description": "The server's answer body, verbatim (api/openapi.yaml).",
      "type": [
        "object",
        "null"
      ]
    },
    "rejection": {
      "description": "The server refused the request itself; nothing executed and the same bytes would be refused again.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "http_status",
            "code",
            "message"
          ],
          "properties": {
            "http_status": {
              "type": "integer"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "unresolved": {
      "description": "Set only when a retry bound ran out without a terminal answer. For a write this is NOT a failure: it may have executed.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bound",
            "sends",
            "nodes_tried"
          ],
          "properties": {
            "bound": {
              "enum": [
                "attempts",
                "nodes",
                "deadline"
              ]
            },
            "sends": {
              "type": "integer",
              "minimum": 0
            },
            "nodes_tried": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "notes": {
      "description": "Things worth telling the person: unreachable nodes, unreadable answers. Bounded.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
