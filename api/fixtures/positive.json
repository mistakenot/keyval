{
  "schema": "keyval.spec.fixtures/v1",
  "expect": "valid",
  "cases": [
    {
      "name": "put-body-plan-example",
      "rule": "§8.6 PUT example",
      "target": {
        "request": "putKey"
      },
      "instance": {
        "value": "hello"
      }
    },
    {
      "name": "put-body-empty-value",
      "rule": "DM-2: a value may be 0 bytes",
      "target": {
        "request": "putKey"
      },
      "instance": {
        "value": ""
      }
    },
    {
      "name": "put-body-value-64KiB-ascii",
      "rule": "DM-2: 65,536 bytes is the largest value",
      "target": {
        "request": "putKey"
      },
      "instance": {
        "value": {
          "$repeat": "v",
          "times": 65536
        }
      }
    },
    {
      "name": "put-body-value-64KiB-4-byte-chars",
      "rule": "DM-2: 16,384 four-byte characters are exactly 65,536 bytes",
      "target": {
        "request": "putKey"
      },
      "instance": {
        "value": {
          "$repeat": "😀",
          "times": 16384
        }
      }
    },
    {
      "name": "cas-body-plan-example",
      "rule": "§8.6 compare-and-swap example",
      "target": {
        "request": "compareAndSwap"
      },
      "instance": {
        "expected": {
          "kind": "version",
          "version": 41
        },
        "value": "12"
      }
    },
    {
      "name": "cas-body-expect-absent",
      "rule": "F-5: expected is absent",
      "target": {
        "request": "compareAndSwap"
      },
      "instance": {
        "expected": {
          "kind": "absent"
        },
        "value": "first"
      }
    },
    {
      "name": "cas-body-expected-version-max",
      "rule": "D-77: 2^53 - 1 is the largest valid integer",
      "target": {
        "request": "compareAndSwap"
      },
      "instance": {
        "expected": {
          "kind": "version",
          "version": 9007199254740991
        },
        "value": "x"
      }
    },
    {
      "name": "key-1-byte",
      "rule": "DM-1: 1 byte is the shortest key",
      "target": {
        "parameter": {
          "operation": "getKey",
          "name": "key"
        }
      },
      "instance": "a"
    },
    {
      "name": "key-256-bytes-ascii",
      "rule": "DM-1: 256 bytes is the longest key",
      "target": {
        "parameter": {
          "operation": "getKey",
          "name": "key"
        }
      },
      "instance": {
        "$repeat": "k",
        "times": 256
      }
    },
    {
      "name": "key-256-bytes-2-byte-chars",
      "rule": "DM-1: 128 two-byte characters are 256 bytes",
      "target": {
        "parameter": {
          "operation": "putKey",
          "name": "key"
        }
      },
      "instance": {
        "$repeat": "é",
        "times": 128
      }
    },
    {
      "name": "key-256-bytes-4-byte-chars",
      "rule": "DM-1: 64 four-byte characters are 256 bytes",
      "target": {
        "parameter": {
          "operation": "deleteKey",
          "name": "key"
        }
      },
      "instance": {
        "$repeat": "😀",
        "times": 64
      }
    },
    {
      "name": "key-with-reserved-characters",
      "rule": "§8.1: keys may contain / ? & (and, once decoded, + space %)",
      "target": {
        "parameter": {
          "operation": "compareAndSwap",
          "name": "key"
        }
      },
      "instance": "a/b?c&d+e f%"
    },
    {
      "name": "key-decomposed-form",
      "rule": "DM-1: no Unicode normalisation; a decomposed form is a valid key",
      "target": {
        "parameter": {
          "operation": "getKey",
          "name": "key"
        }
      },
      "instance": "é"
    },
    {
      "name": "scan-start-key",
      "rule": "§8.5: start is a key",
      "target": {
        "parameter": {
          "operation": "scanKeys",
          "name": "start"
        }
      },
      "instance": "a"
    },
    {
      "name": "scan-limit-1",
      "rule": "F-4: limit 1 is the smallest",
      "target": {
        "parameter": {
          "operation": "scanKeys",
          "name": "limit"
        }
      },
      "instance": 1
    },
    {
      "name": "scan-limit-128",
      "rule": "F-4: limit 128 is the largest",
      "target": {
        "parameter": {
          "operation": "scanKeys",
          "name": "limit"
        }
      },
      "instance": 128
    },
    {
      "name": "idempotency-key-plan-example",
      "rule": "F-6: 32 lowercase hex characters",
      "target": {
        "parameter": {
          "operation": "putKey",
          "name": "Idempotency-Key"
        }
      },
      "instance": "d70ff69df7084a088e4a531837cc4e5a"
    },
    {
      "name": "status-request-id-path",
      "rule": "F-9: the path carries a request ID",
      "target": {
        "parameter": {
          "operation": "getRequestStatus",
          "name": "request_id"
        }
      },
      "instance": "7f3c0b8e2a6d4f19b1c5e0a9d8f7c6b5"
    },
    {
